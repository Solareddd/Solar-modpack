{
	"schemaVersion": 1,
	"id": "solar",
	"version": "${version}",
	"name": "Solar Mod",
	"description": "A modpack creating a balanced minmized lag mob farm progression system",
	"authors": [
		"Solar"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Solareddd/Solar-modpack"
	},
	"license": "CC0-1.0",
	"icon": "assets/solar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.SolarMod.SolarMod"
		],
		"client": [
			"com.example.ExampleModClient"
		],
        "fabric-datagen": [
          "com.SolarMod.SolarModDataGenerator"
        ]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}